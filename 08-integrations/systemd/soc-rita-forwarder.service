[Unit]
Description=SOC Lab - RITA Beaconing Detection to TheHive Forwarder
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/soc-threat-hunting-lab/08-integrations
Environment="THEHIVE_URL=http://192.168.60.20:9000"
Environment="THEHIVE_KEY=YOUR_THEHIVE_API_KEY"
Environment="RITA_DB=soc-hunt"
Environment="BEACON_THRESHOLD=0.7"
ExecStart=/usr/bin/python3 /opt/soc-threat-hunting-lab/08-integrations/scripts/rita-to-thehive.py --watch --interval 300
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
